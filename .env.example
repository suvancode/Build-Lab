# =====================================================================
# Build Lab - Environment Configuration
# =====================================================================

# MongoDB Atlas connection URI (include database name, e.g. /buildlab)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/buildlab?retryWrites=true&w=majority

# Secret key for signing admin JWT tokens (min 32 characters recommended)
JWT_SECRET=your_super_secret_jwt_key_generate_random_32_characters

# Default admin password for first-time seeding
ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# Default GitHub username to fetch repositories from (optional, defaults to adityasing9)
GITHUB_USERNAME=adityasing9
